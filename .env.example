# Base URL of the IKGS API.
# Leave empty in development to use the Vite proxy (/api -> http://localhost:5000).
# In production set the full API origin, e.g. https://api.ikgssolution.com/api
VITE_API_URL=https://ikgs-server.onrender.com/

# Public site URL used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://ikgssolution.com

# Dev-server proxy target (used by vite.config.js only)
VITE_PROXY_TARGET=http://localhost:5000
